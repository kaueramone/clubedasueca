NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Origin used for confirmation/recovery redirects and affiliate links; allow it in Supabase Auth.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Community chat bot (Groq — https://console.groq.com)
GROQ_API_KEY=your-groq-api-key
NEXT_PUBLIC_BOT_USER_ID=00000000-0000-0000-0000-000000000001

# Server-only. This release cannot enable real payments by changing a flag.
PLATFORM_MODE=beta
# Create and rotate these values in the provider/deployment settings. Never use example text in production.
TURNSTILE_SECRET_KEY=replace-with-server-side-turnstile-secret
CRON_SECRET=replace-with-unique-random-cron-secret
COMMUNITY_WEBHOOK_SECRET=replace-with-unique-random-webhook-secret
